---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { allPosts } from '../../lib/posts';
const posts = await allPosts();
const years = [...new Set(posts.map(p=>p.data.date.slice(0,4)))];
---
<Base title="文章归档"><section class="wrap inner-page"><p class="eyebrow">THE ARCHIVE</p><h1>时间里的记录。</h1><p class="page-intro">共 {posts.length} 篇文章，一点点积累，一点点生长。</p>{years.map(year=><section class="archive-year"><h2>{year}</h2><PostList posts={posts.filter(p=>p.data.date.startsWith(year))} /></section>)}</section></Base>
